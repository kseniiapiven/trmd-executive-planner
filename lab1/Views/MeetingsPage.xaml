<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExecutivePlanner.ViewModels"
             xmlns:models="clr-namespace:ExecutivePlanner.Models"
             x:Class="ExecutivePlanner.Views.MeetingsPage"
             x:DataType="vm:MeetingsViewModel"
             Title="Планувальник керівника">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <Label Grid.Row="0" Text="{Binding StatusText}" FontSize="16" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Meetings}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Meeting">
                    <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding StartDisplay}" />
                            <Label Text="{Binding Location}" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Додайте першу зустріч" HorizontalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Entry Placeholder="Назва зустрічі" Text="{Binding NewTitle}" />
            <Entry Placeholder="Місце / посилання" Text="{Binding NewLocation}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <DatePicker Grid.Column="0" Date="{Binding NewDate}" />
                <TimePicker Grid.Column="1" Time="{Binding NewTime}" />
            </Grid>
            <Button Text="Додати зустріч" Command="{Binding AddMeetingCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
