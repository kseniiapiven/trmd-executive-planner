<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExecutivePlanner.ViewModels"
             x:Class="ExecutivePlanner.Views.MeetingDetailPage"
             x:DataType="vm:MeetingDetailViewModel"
             Title="Деталі зустрічі">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="{Binding StartDisplay}" FontSize="16" TextColor="Gray" />
        <Entry Placeholder="Назва" Text="{Binding Title}" />
        <Entry Placeholder="Місце / посилання" Text="{Binding Location}" />
        <Editor Placeholder="Нотатки до зустрічі" Text="{Binding Notes}" HeightRequest="160" />
        <Button Text="Зберегти" Command="{Binding SaveCommand}" />
        <Button Text="Видалити" Command="{Binding DeleteCommand}" BackgroundColor="#B3261E" />
    </VerticalStackLayout>
</ContentPage>
