<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExecutivePlanner.ViewModels"
             x:Class="ExecutivePlanner.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Вхід">
    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
        <Label Text="Планувальник керівника" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <Entry Placeholder="Логін" Text="{Binding Login}" Keyboard="Plain" />
        <Entry Placeholder="Пароль" Text="{Binding Password}" IsPassword="True" />
        <Button Text="Увійти" Command="{Binding LoginCommand}" />
    </VerticalStackLayout>
</ContentPage>
