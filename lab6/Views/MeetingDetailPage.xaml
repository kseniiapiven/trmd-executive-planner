<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExecutivePlanner.ViewModels"
             x:Class="ExecutivePlanner.Views.MeetingDetailPage"
             x:DataType="vm:MeetingDetailViewModel"
             Title="Деталі зустрічі">
    <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="{Binding StartDisplay}" FontSize="16" TextColor="Gray" />
        <Entry Placeholder="Назва" Text="{Binding Title}" />
        <Entry Placeholder="Місце / посилання" Text="{Binding Location}" />
        <Editor Placeholder="Нотатки до зустрічі" Text="{Binding Notes}" HeightRequest="110" />
        <Image Source="{Binding ImagePath}" IsVisible="{Binding HasImage}" HeightRequest="180" Aspect="AspectFit" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Зробити фото" Command="{Binding TakePhotoCommand}" />
            <Button Grid.Column="1" Text="Визначити місце" Command="{Binding DetectLocationCommand}" />
        </Grid>
        <Label Text="{Binding CoordinatesText}" FontSize="14" TextColor="Gray" />
        <Button Text="Зберегти" Command="{Binding SaveCommand}" />
        <Button Text="Видалити" Command="{Binding DeleteCommand}" BackgroundColor="#B3261E" IsVisible="{Binding CanDelete}" />
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
